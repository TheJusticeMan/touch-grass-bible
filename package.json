{
  "name": "touch-grass-bible-workspace",
  "version": "4.0.0-beta",
  "private": true,
  "description": "The bible app that keeps you grounded in the word while letting you into some functionality.",
  "keywords": [
    "bible",
    "scripture",
    "religion",
    "christianity",
    "devotional",
    "faith",
    "worship",
    "study",
    "spiritual",
    "biblical"
  ],
  "repository": {
    "type": "git",
    "url": "touch-grass-bible"
  },
  "license": "MIT",
  "author": "Justice Vellacott",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install",
    "init": "npm run setup",
    "dev": "npm run dev:capacitor",
    "dev:app": "npm run dev --workspace=@touchgrass/app",
    "dev:watch": "APP_TARGET=capacitor node esbuild.config.mjs",
    "dev:capacitor": "npm run data:prepare && concurrently --kill-others-on-fail --names BUILD,SERVE --prefix-colors cyan,green \"npm run dev:watch\" \"npm run serve\"",
    "serve": "live-server ./dist --port=3000 --browser=firefox",
    "build": "npm run build:bundle:capacitor",
    "build:framework": "npm run build --workspace=@touchgrass/framework",
    "build:app": "npm run build --workspace=@touchgrass/app",
    "build:bundle:capacitor": "npm run data:prepare && APP_TARGET=capacitor node esbuild.config.mjs production",
    "build:bundle:electron": "npm run data:prepare && APP_TARGET=electron node esbuild.config.mjs production",
    "build:electron": "node scripts/electron/build.mjs",
    "run:electron": "node scripts/electron/run.mjs",
    "package:electron": "node scripts/electron/package.mjs",
    "make:electron": "node scripts/electron/make.mjs",
    "build:capacitor": "npm run platform:sync",
    "lint": "npm run lint:css && eslint \"src/**/*.ts\" \"packages/framework/src/**/*.ts\"",
    "lint:css": "CSS_LINT_BUNDLE=true npm run build:bundle:capacitor && eslint \"dist/main.css\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"packages/framework/src/**/*.ts\" --fix",
    "format": "prettier --write \"*.{ts,tsx,js,mjs,cjs,css,md}\" \"**/*.{ts,tsx,js,mjs,cjs,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test --workspaces --if-present",
    "clean": "rm -rf ./dist/* ./dist/",
    "data:download": "node scripts/data/download-openbible.mjs",
    "data:download:bible": "node scripts/data/download-biblesupersearch.mjs",
    "data:download:english": "node scripts/data/download-biblesupersearch-english.mjs",
    "data:assets": "node scripts/data/copy-embedding-assets.mjs",
    "data:prepare": "npm run data:download && npm run data:assets",
    "data:embed": "node scripts/data/generate-embeddings.mjs",
    "data:topics": "node scripts/data/generate-verse-topics.mjs && node scripts/data/generate-topic-labels.mjs",
    "data:map": "node scripts/data/generate-map-coords.mjs",
    "data:all": "npm run data:prepare && npm run data:embed && npm run data:topics && npm run data:map",
    "platform:add": "node scripts/platform/add.mjs",
    "platform:sync": "node scripts/platform/sync.mjs",
    "platform:open": "node scripts/platform/open.mjs",
    "platform:run": "node scripts/platform/run.mjs",
    "platform:android": "npm run platform:run -- android",
    "platform:ios": "npm run platform:run -- ios",
    "ai:wander": "node scripts/ai/wander.mjs",
    "ai:wander:start": "node scripts/ai/wander-control.mjs start",
    "ai:wander:stop": "node scripts/ai/wander-control.mjs stop",
    "ai:wander:restart": "node scripts/ai/wander-control.mjs restart",
    "ai:wander:status": "node scripts/ai/wander-control.mjs status",
    "ai:wander:tail": "node scripts/ai/wander-control.mjs tail"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.2.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/status-bar": "^8.0.1",
    "@orama/orama": "^3.1.18",
    "@touchgrass/framework": "*",
    "apocalypse-throttle": "^0.0.0",
    "cli-progress": "^3.12.0",
    "d3": "^7.9.0",
    "lucide": "^1.18.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^26.6.5",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.2",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.4.0",
    "https": "^1.0.0",
    "jsdom": "^30.0.1",
    "knip": "^6.16.1",
    "live-server": "^1.2.0",
    "ml-kmeans": "^7.0.0",
    "ml-pca": "^4.1.1",
    "path": "^0.12.7",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "umap-js": "^1.4.0",
    "unzipper": "^0.12.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
