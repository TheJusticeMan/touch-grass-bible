{
  "name": "touch-grass-bible",
  "version": "3.1.1",
  "description": "The bible app that keeps you grounded in the word while letting you into some functionality.",
  "keywords": [
    "bible",
    "scripture",
    "religion",
    "christianity",
    "devotional",
    "faith",
    "worship",
    "study",
    "spiritual",
    "biblical"
  ],
  "repository": {
    "type": "git",
    "url": "touch-grass-bible"
  },
  "license": "MIT",
  "author": "Justice Vellacott",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node esbuild.config.mjs",
    "build": "npm run getdatafiles && node esbuild.config.mjs production",
    "init": "npm install",
    "format": "prettier --write \"src/**/*.ts\" && prettier --write \"*.md\"",
    "getdatafiles": "node ./processing/online.mjs && cp src/translations.json dist",
    "build:web": "mkdir -p ./dist && npm run build && cp src/web/* dist",
    "lint": "eslint src/*.ts",
    "clean": "rm -rf ./dist/* ./dist/",
    "ai": "node ./processing/filetochat.mjs",
    "build:electron": "mkdir -p ./dist && npm run build && cp ./src/electron/* ./dist && cd dist && npm install && npm run start",
    "run:embed": "esbuild processing/embedding.ts --bundle --platform=node --format=esm --outfile=processing/embedding.js && node processing/embedding.js && rm processing/embedding.js",
    "build:capacitor": "npm run build:web && npx cap sync",
    "sync:capacitor": "npx cap sync",
    "run:android": "npx cap run android",
    "run:ios": "npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/status-bar": "^7.0.3",
    "@orama/orama": "^3.1.18",
    "apocalypse-throttle": "^0.0.0",
    "cli-progress": "^3.12.0",
    "glob": "^11.0.2",
    "js-levenshtein": "^1.1.6",
    "ollama": "^0.5.16",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^16.11.6",
    "@types/p-limit": "^2.1.0",
    "@types/unzipper": "^0.10.11",
    "esbuild": "^0.25.4",
    "eslint": "^9.39.1",
    "fs": "^0.0.1-security",
    "globals": "^16.5.0",
    "https": "^1.0.0",
    "lucide": "^0.511.0",
    "path": "^0.12.7",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "unzipper": "^0.12.3"
  }
}
