{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "./dist/types",
    "paths": {
      "@platform": ["./src/platform/current.ts"],
      "@touchgrass/framework": ["./packages/framework/src/index.ts"],
      "@touchgrass/framework/*": ["./packages/framework/src/*"]
    }
  },
  "include": ["../../src", "../../scripts"],
  "references": [{ "path": "../framework" }]
}
